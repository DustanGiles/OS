<xml xmlns="https://developers.google.com/blockly/xml"><variables><variable id="+e,uJqUG^,]d~Vnmm!z(">outlineColour</variable><variable id=".2FMD:4?dK@QFOzHtFLG">currentMenu</variable><variable id="!xw3n[nw5:q356KIOYAZ">mainMenu</variable></variables><block type="pxt-on-start" id="@O]IMsg/cGF*5HGW1A2O" x="20" y="20"><statement name="HANDLER"><block type="typescript_statement" id="2K,S]+h/13*ao(hR~8Ic"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="class Text {" line1="    x: number;" line2="    y: number;" line3="    text: TextSprite;" line4="" line5="    constructor(x: number, y: number, label: string, outline: number=6) {" line6="        this.x = x;" line7="        this.y = y;" line8="        this.text = textsprite.create(label);" line9="        this.text.setMaxFontHeight(9);" line10="        this.text.setOutline(1, outline);" line11="        this.text.setPosition(x, y);" line12="        this.text.z = 10;" line13="    } " line14="" line15="    setPosition(x: number, y: number): void {" line16="        this.text.setPosition(x, y);" line17="    }" line18="" line19="    destroy(): void {" line20="        sprites.destroy(this.text);" line21="    }" line22="}" numlines="23"></mutation><next><block type="typescript_statement" id="(;Sa0IxuKQ/#KSN4?IsS"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="class Menu {" line1="    items: string[];" line2="    labels: Text[];" line3="    actions: { [key: string]: () =&gt; void };" line4="    selectedIndex: number;" line5="    x: number;" line6="    y: number;" line7="" line8="    constructor(actions: { [key: string]: () =&gt; void }, x: number, y: number) {" line9="        this.items = Object.keys(actions);" line10="        this.actions = actions;" line11="        this.labels = [];" line12="        this.selectedIndex = 0;" line13="        this.x = x;" line14="        this.y = y;" line15="" line16="        let offsetY = y;" line17="        for (let label of this.items) {" line18="            this.labels.push(new Text(x, offsetY, label, outlineColour));" line19="            offsetY += 10;" line20="        }" line21="    }" line22="" line23="    updateSelection(index: number): void {" line24="        let offsetY2 = this.y + (this.y - this.labels[index].y);" line25="        for (let label2 of this.labels) {" line26="            label2.setPosition(this.x, offsetY2);" line27="            offsetY2 += 10;" line28="        }" line29="    }" line30="" line31="    getSelectedItem(): string {" line32="        return this.items[this.selectedIndex];" line33="    }" line34="" line35="    get length(): number {" line36="        return this.items.length;" line37="    }" line38="" line39="    selectNext(): void {" line40="        this.selectedIndex = Math.min(this.length - 1, this.selectedIndex + 1);" line41="    }" line42="" line43="    selectPrev(): void {" line44="        this.selectedIndex = Math.max(0, this.selectedIndex - 1);" line45="    }" line46="" line47="    activate(): void {" line48="        let selected = this.getSelectedItem();" line49="        this.actions[selected]();" line50="    }" line51="" line52="    destroy(): void {" line53="        for (let label3 of this.labels) {" line54="            label3.destroy();" line55="        }" line56="    }" line57="" line58="    handleInput(): void {" line59="        if (controller.up.isPressed()) {" line60="            this.selectPrev();" line61="            pause(100);" line62="        }" line63="" line64="        if (controller.down.isPressed()) {" line65="            this.selectNext();" line66="            pause(100);" line67="        }" line68="" line69="        if (controller.A.isPressed()) {" line70="            this.activate();" line71="            pause(500)" line72="        }" line73="" line74="        this.updateSelection(this.selectedIndex);" line75="    }" line76="}" numlines="77"></mutation><next><block type="variables_set" id="M`HAGI%:Ds-;+]6nl}oM"><field name="VAR" id="+e,uJqUG^,]d~Vnmm!z(">outlineColour</field><value name=